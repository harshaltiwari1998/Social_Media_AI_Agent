OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Keep true until you've reviewed generated content and are ready to post live.
DRY_RUN=true

# --- Trend sources (all optional; missing ones are skipped automatically) ---
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=universal-ai-agent/0.1 trend-fetcher
TWITTER_BEARER_TOKEN=

# --- Social posting (Stage 4) ---
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
YOUTUBE_CLIENT_SECRET_FILE=

# Instagram needs media at a public URL (no raw-upload endpoint) - point this
# at whatever serves MEDIA_OUTPUT_DIR publicly (e.g. an ngrok tunnel).
MEDIA_PUBLIC_BASE_URL=

# --- Pipeline orchestrator (Stage 5) ---
# JSON list of platform names the scheduled pipeline posts to by default.
# Gaming content -> GAMING_PLATFORMS, movies -> MOVIE_PLATFORMS, everything else -> TARGET_PLATFORMS.
TARGET_PLATFORMS=["instagram","facebook"]
GAMING_PLATFORMS=["youtube","instagram"]
MOVIE_PLATFORMS=["youtube_movies","instagram","facebook"]
# Two YouTube channels, one login each (scripts/youtube_login.py youtube | youtube_movies).
# Category: 20 = Gaming, 24 = Entertainment
YOUTUBE_TOKEN_FILE=.cache/youtube_token.json
YOUTUBE_CATEGORY_ID=20
YOUTUBE_MOVIES_TOKEN_FILE=.cache/youtube_token_movies.json
YOUTUBE_MOVIES_CATEGORY_ID=24

# --- Analysis LLM backend ---
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Media generation (Stage 2/3) ---
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SD_BASE_SIZE=768
# x4 upscaler is very slow on a 4GB GPU (~1hr/image even tiled) - off by default,
# turn on for one-off high-res generations only.
SD_ENABLE_UPSCALE=false
SD_UPSCALER_MODEL_ID=stabilityai/stable-diffusion-x4-upscaler
MEDIA_OUTPUT_DIR=media_output
# Hindi narration voice by default - see `edge-tts --list-voices` for other hi-IN/en-* options.
TTS_VOICE=hi-IN-SwaraNeural

# Used for Instagram when MEDIA_PUBLIC_BASE_URL is empty (temporary Cloudflare quick tunnel)
CLOUDFLARED_PATH=cloudflared
